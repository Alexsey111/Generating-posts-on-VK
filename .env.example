# OpenAI API Configuration
# Получить ключ можно на https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# VK API Configuration
# Получить токен можно в настройках сообщества ВКонтакте
VK_API_KEY=your-vk-api-token-here
VK_GROUP_ID=226084011

# Flask Configuration
# Секретный ключ для подписи cookies (измените в продакшене!)
SECRET_KEY=change-this-secret-key-in-production

# Database Configuration (опционально, по умолчанию используется SQLite)
# DATABASE_URL=sqlite:///app.db
# Для PostgreSQL: postgresql://username:password@localhost/dbname
# Для MySQL: mysql://username:password@localhost/dbname

# Logging Configuration
LOG_LEVEL=INFO

# Output directory for reports (опционально)
OUTPUT_DIR=reports/

# Debug mode (опционально)
DEBUG=False